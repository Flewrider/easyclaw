#!/bin/bash
export PATH="%%HOME%%/.local/bin:$PATH"

SESSION="claude"
WORKDIR="%%HOME%%"
CLAUDE="%%HOME%%/.local/bin/claude"
EASYCLAW="%%HOME%%/.easyclaw"
RESTART_HISTORY="$EASYCLAW/restart-history"
BRIDGE_PORT=$(grep "^BRIDGE_PORT=" "$EASYCLAW/.env" 2>/dev/null | cut -d= -f2)
BRIDGE_PORT="${BRIDGE_PORT:-8765}"
export IS_SANDBOX=1

mkdir -p "$EASYCLAW"
echo "idle" > "$EASYCLAW/status"

# ── Restart loop detection ────────────────────────────────────────────────
echo "$(date +%s)" >> "$RESTART_HISTORY"
tail -20 "$RESTART_HISTORY" > "$RESTART_HISTORY.tmp" 2>/dev/null && mv "$RESTART_HISTORY.tmp" "$RESTART_HISTORY"
NOW=$(date +%s); RECENT=0
while IFS= read -r ts; do
    [ -n "$ts" ] && [ $(( NOW - ts )) -le 180 ] && RECENT=$(( RECENT + 1 ))
done < "$RESTART_HISTORY"

if [ "$RECENT" -ge 4 ]; then
    TIMESTAMP=$(date '+%Y-%m-%d %H:%M')
    LOG="$EASYCLAW/activity-log.md"
    echo "[$TIMESTAMP] system: Restart loop ($RECENT in 3min) — recovery agent" >> "$LOG"
    TOKEN=$(grep "^TELEGRAM_BOT_TOKEN=" "$EASYCLAW/.env" 2>/dev/null | cut -d= -f2)
    CHAT_ID=$(grep "^TELEGRAM_CHAT_ID=" "$EASYCLAW/.env" 2>/dev/null | cut -d= -f2 | cut -d, -f1)
    [ -n "$TOKEN" ] && [ -n "$CHAT_ID" ] && curl -s --max-time 10 \
        "https://api.telegram.org/bot${TOKEN}/sendMessage" \
        -d "chat_id=${CHAT_ID}" --data-urlencode "text=⚠️ Restart loop: $RECENT crashes in 3min. Recovery agent spawned." > /dev/null 2>&1 || true
    echo "" > "$RESTART_HISTORY"
    nohup "$CLAUDE" -p "RECOVERY MODE: crashed $RECENT times in 3min. Check: journalctl -u claude-code -n 100; tail -40 ~/.easyclaw/activity-log.md; cat ~/claude-start.sh — fix root cause then: sudo systemctl restart claude-code" \
        --dangerously-skip-permissions > "$EASYCLAW/recovery-agent.log" 2>&1 &
    exec sleep 1200
fi
# ─────────────────────────────────────────────────────────────────────────

# Determine restart context
LAUNCHED="$EASYCLAW/has-launched"
RESUME="$EASYCLAW/restart-resume"
CTX_FILE="$EASYCLAW/current-context"

if [ ! -f "$LAUNCHED" ]; then
    touch "$LAUNCHED"
    cat > "$CTX_FILE" <<'CTX'
FIRST LAUNCH: This is the very first startup after installation. Send a Telegram greeting to let the user know you are online, then ask if they would like to run onboarding (name, timezone, primary use cases, daily briefing preference). Save responses to memory.
CTX
elif [ -f "$RESUME" ]; then
    cp "$RESUME" "$CTX_FILE"
    rm -f "$RESUME"
else
    cat > "$CTX_FILE" <<'CTX'
RESTART CONTEXT: you crashed unexpectedly. Check ~/.easyclaw/activity-log.md for recent work, find the cause if possible, then continue where you left off.
CTX
fi

# Log to dashboard so it shows as first SYS bubble in chat
PAYLOAD=$(python3 -c "
import json, sys
ctx = open(sys.argv[1]).read().strip()
print(json.dumps({'message': ctx, 'source': 'restart', 'sender': 'system'}))
" "$CTX_FILE" 2>/dev/null)
[ -n "$PAYLOAD" ] && curl -sf --max-time 3 -X POST "http://127.0.0.1:$BRIDGE_PORT/chat" \
    -H 'Content-Type: application/json' -d "$PAYLOAD" > /dev/null 2>&1 || true

# Kill stale session
tmux kill-session -t "$SESSION" 2>/dev/null

# Start Claude — context passed as first positional arg (guaranteed first prompt)
# Written to file to safely handle quotes/special chars in the shell command
tmux new-session -d -s "$SESSION" -c "$WORKDIR" -n "claude" \
  "while true; do \
    $CLAUDE \"\$(cat $CTX_FILE)\" --continue --dangerously-skip-permissions --chrome \
    || $CLAUDE \"\$(cat $CTX_FILE)\" --dangerously-skip-permissions --chrome; \
    echo '[claude exited — restarting in 3s...]'; sleep 3; \
  done"

while tmux has-session -t "$SESSION" 2>/dev/null; do sleep 2; done
