#!/bin/bash
# clawdy-restart — gracefully restart the Claude Code session via systemd
#
# Usage: clawdy-restart "reason" "what to resume after restart"
# Both args required — the resume note is written to ~/.easyclaw/restart-resume
# and injected into the [restart] prompt so the new session knows what to do.

if [ -z "${1:-}" ] || [ -z "${2:-}" ]; then
  echo "Usage: clawdy-restart \"reason\" \"what to resume after restart\""
  exit 1
fi

REASON="$1"
RESUME="$2"
LOG_FILE="$HOME/.easyclaw/activity-log.md"
RESUME_FILE="$HOME/.easyclaw/restart-resume"
TIMESTAMP=$(date '+%Y-%m-%d %H:%M')

mkdir -p "$HOME/.easyclaw"

# Build mini-briefing: recent activity + pending tasks
RECENT_ACTIVITY=$(tail -3 "$LOG_FILE" 2>/dev/null | sed 's/^/  /' || echo "  (none)")
PENDING_TASKS=$(grep '^\[Pending\]' "$HOME/.easyclaw/tasks.md" 2>/dev/null | head -3 | sed 's/^/  /' || echo "  (none)")

cat > "$RESUME_FILE" <<RESUME_EOF
$RESUME

Recent activity:
$RECENT_ACTIVITY

Pending tasks:
$PENDING_TASKS
RESUME_EOF

echo "[$TIMESTAMP] system: Restarting — $REASON" >> "$LOG_FILE"
echo "Restarting Claude Code (reason: $REASON)..."

# Try dashboard API first (preferred — managed restart via clawdy-bridge).
#
# MUST be https. The dashboard logs "TLS enabled — serving HTTPS on 0.0.0.0:8765"
# and then, misleadingly, "Dashboard available at http://0.0.0.0:8765" on the very
# next line. This script believed the second line, so every request died with
# "Connection reset by peer" (plaintext to a TLS socket), the API path NEVER
# succeeded, and EVERY self-restart silently took the fallback below.
# -k because the cert is self-signed.
BRIDGE_PORT=$(grep "^BRIDGE_PORT=" "$HOME/.easyclaw/.env" 2>/dev/null | cut -d= -f2)
BRIDGE_PORT="${BRIDGE_PORT:-8765}"
if curl -skf --max-time 3 -X POST "https://127.0.0.1:$BRIDGE_PORT/api/claude-start" > /dev/null 2>&1; then
  echo "  Restarted via dashboard API (port $BRIDGE_PORT)"
else
  # Fallback: hand the restart to systemd. Do NOT kill tmux and relaunch the start
  # script by hand — that was the old fallback and it caused the double-restart:
  # killing the session makes the systemd-supervised script exit, so systemd
  # restarts the unit ~10s later, while the manual `bash ... &` had already started
  # a session and CONSUMED the single-use restart-resume file. The systemd copy then
  # killed that session, found no resume note, and reported "you crashed
  # unexpectedly". Letting systemd own the restart gives exactly one session and
  # leaves the resume note for it to read.
  echo "  Dashboard API unreachable — restarting via systemd"
  systemctl restart claude-code-channels.service
fi
